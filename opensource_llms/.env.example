# =============================================================================
# vLLM Open-Source LLM Configuration
# =============================================================================
# Copy this file to the project root as .env:
#   cp opensource_llms/.env.example .env
#
# Then edit .env and fill in your actual values.
# =============================================================================

# -----------------------------------------------------------------------------
# HUGGINGFACE TOKEN (REQUIRED)
# -----------------------------------------------------------------------------
# Required for downloading gated/private models from HuggingFace Hub.
# The Qwen3 models used in this setup are gated and require authentication.
#
# To get your token:
#   1. Create a HuggingFace account at https://huggingface.co/
#   2. Go to https://huggingface.co/settings/tokens
#   3. Create a new token with "read" access
#   4. Accept the model license agreements:
#      - https://huggingface.co/Qwen/Qwen3-30B-A3B-Thinking-2507-FP8
#      - https://huggingface.co/Qwen/Qwen3-Embedding-8B
#
HF_TOKEN=hf_your_huggingface_token_here

# -----------------------------------------------------------------------------
# VLLM API KEY (OPTIONAL but RECOMMENDED)
# -----------------------------------------------------------------------------
# API key for authenticating requests to the vLLM OpenAI-compatible endpoints.
# Use any secure random string. If not set, defaults to "EMPTY" (no auth).
#
# Generate a secure key:
#   openssl rand -hex 32
#
# When using the API, include this in your requests:
#   Authorization: Bearer your_api_key_here
#
VLLM_API_KEY=your_secure_api_key_here

# -----------------------------------------------------------------------------
# OPENAI API KEY (for cloud-based LLM-Lasso, not vLLM)
# -----------------------------------------------------------------------------
# If you're using OpenAI's API instead of local vLLM, set this:
# OPENAI_API_KEY=sk-your-openai-api-key-here
